---
import { fuentesPorId, type Cita as TipoCita } from '../data/fuentes';
import Icon from './Icon.astro';

type Props = {
  fuenteId: string;
  /** Fragmento que identifica la cita dentro de la fuente. */
  buscar: string;
  /** Sobrescribe el texto si hace falta recortarlo con elipsis. */
  texto?: string;
  variante?: 'bloque' | 'grande' | 'fila';
  clase?: string;
};

const { fuenteId, buscar, texto, variante = 'bloque', clase } = Astro.props;

const fuente = fuentesPorId.get(fuenteId);
if (!fuente) throw new Error(`Fuente no encontrada: ${fuenteId}`);

const cita: TipoCita =
  fuente.citas.find((c) => c.texto.includes(buscar)) ??
  (() => {
    throw new Error(`Cita no encontrada en ${fuenteId}: ${buscar}`);
  })();

const cuerpo = texto ?? cita.texto;
const lang = cita.idioma === 'en' ? 'en' : 'es';
/* Una fecha sin dia ni mes se imprime tal cual: no se inventa la precision
   que la fuente no da. */
const fecha = /^\d{4}$/.test(fuente.fecha)
  ? fuente.fecha
  : new Date(fuente.fecha + 'T12:00:00Z').toLocaleDateString('es-PE', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });

/** Jerarquia de la fuente: primaria > secundaria > comercial. No depende solo
    del color: la etiqueta lleva siempre el texto del tipo. */
const rango: Record<string, string> = {
  oficial: 'primaria',
  norma: 'primaria',
  academica: 'primaria',
  institucional: 'declaracion',
  complementaria: 'secundaria',
};

const tipoEtiqueta =
  fuente.tipo === 'norma'
    ? 'norma'
    : fuente.tipo === 'academica'
      ? 'artículo arbitrado'
      : fuente.tipo === 'oficial'
        ? 'fuente oficial'
        : fuente.tipo === 'complementaria'
          ? 'fuente de empresa'
          : 'declaración institucional';
---

<figure class:list={['cita', `cita--${variante}`, clase]} data-reveal>
  <blockquote class="cita__texto" lang={lang}>
    <p>{cuerpo}</p>
  </blockquote>

  <figcaption class="cita__fuente">
    <div class="cita__fila">
      <span class="cita__tipo" data-rango={rango[fuente.tipo]}>{tipoEtiqueta}</span>
      <span class="cita__ref">{fuente.id}</span>
    </div>

    <p class="cita__org">
      <strong>{fuente.org}</strong>
      {fuente.autor && <span class="cita__autor">{fuente.autor}</span>}
    </p>

    <p class="cita__obra">
      <cite>{fuente.titulo}</cite>
      {fuente.medio && <span> — {fuente.medio}</span>}
    </p>

    <div class="cita__pie">
      <span class="cita__fecha">
        {fuente.fechaTipo === 'consulta' ? 'consultada el ' : ''}{fecha}
      </span>
      <span class="cita__sep" aria-hidden="true">·</span>
      <span class="cita__acceso">lectura {fuente.acceso}</span>
      <a
        class="cita__enlace"
        href={fuente.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Abrir fuente: ${fuente.titulo}`}
      >
        ver el original <Icon nombre="external-link" tam={13} />
      </a>
    </div>

    {
      cita.nota && (
        <p class="cita__nota">
          <Icon nombre="circle-alert" tam={13} />
          <span>{cita.nota}</span>
        </p>
      )
    }
  </figcaption>
</figure>

<style>
  .cita {
    border-left: 2px solid var(--ac);
    padding-left: clamp(1rem, 2.5vw, 1.5rem);
  }

  .cita__texto p {
    font-family: var(--display);
    font-weight: 300;
    font-size: 1.1rem;
    line-height: 1.42;
    letter-spacing: -0.012em;
    color: var(--tinta);
    margin: 0 0 0.9rem;
    text-wrap: pretty;
  }

  .cita--grande .cita__texto p {
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .cita--fila {
    border-left-width: 1px;
    border-left-color: var(--linea);
    padding-left: clamp(0.8rem, 2vw, 1.15rem);
  }

  .cita--fila .cita__texto p {
    font-size: 1rem;
    line-height: 1.55;
  }

  .cita--fila .cita__texto {
    margin-bottom: 0.35rem;
  }

  [lang='en'] {
    font-style: italic;
  }

  .cita__fuente {
    display: grid;
    gap: 0.42rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--linea);
  }

  .cita__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cita__tipo {
    font-family: var(--mono);
    font-size: var(--fs-10);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    padding: 0.16rem 0.42rem;
    border-radius: 2px;
    border: 1px solid var(--ac);
    color: var(--ac);
    white-space: nowrap;
  }

  .cita__tipo[data-rango='primaria'] {
    background: var(--ac-hondo);
    border-color: var(--ac-hondo);
    color: #fff;
  }

  .cita__tipo[data-rango='secundaria'] {
    border-color: var(--linea);
    color: var(--tinta-baja);
  }

  .cita__ref {
    font-family: var(--mono);
    font-size: var(--fs-10);
    letter-spacing: 0.06em;
    color: var(--tinta-apagada);
  }

  .cita__org {
    line-height: 1.4;
  }

  .cita__org strong {
    font-size: var(--fs-7);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--tinta);
  }

  .cita__autor {
    display: block;
    font-size: var(--fs-7);
    color: var(--tinta-baja);
    margin-top: 0.1rem;
  }

  .cita__obra {
    font-family: var(--display);
    font-size: 0.95rem;
    line-height: 1.42;
    color: var(--tinta-media);
  }

  .cita__obra cite {
    font-style: italic;
    font-weight: 400;
  }

  .cita__obra span {
    font-style: normal;
    color: var(--tinta-baja);
    font-size: 0.85em;
  }

  .cita__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.25rem;
    font-family: var(--mono);
    font-size: var(--fs-10);
    letter-spacing: 0.05em;
    text-transform: lowercase;
    color: var(--tinta-baja);
  }

  .cita__sep {
    color: var(--linea);
  }

  .cita__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    color: var(--ac);
    border-bottom: 1px solid var(--ac-borde);
    transition: border-color var(--d-2) var(--ease-out);
  }

  .cita__enlace:hover {
    border-color: var(--ac);
  }

  .cita__nota {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin-top: 0.5rem;
    color: var(--tinta-baja);
    text-transform: none;
    letter-spacing: 0.02em;
    font-family: var(--cuerpo);
    font-size: var(--fs-7);
    line-height: 1.5;
  }

  .cita__nota svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--ac);
  }
</style>
