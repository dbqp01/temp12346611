---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import CapituloObjeto from '../components/CapituloObjeto.astro';
import CapituloEvidencia from '../components/CapituloEvidencia.astro';
import CapituloMetodo from '../components/CapituloMetodo.astro';
import CapituloLimites from '../components/CapituloLimites.astro';
import CapituloTesis from '../components/CapituloTesis.astro';
import Fuentes from '../components/Fuentes.astro';
import Pie from '../components/Pie.astro';

const descripcion =
  'Ensayo sobre auditoría de seguridad de la información en sistemas de información académicos, con dieciocho fuentes primarias y cada cifra junto a su base muestral.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="La universidad gestiona datos que nadie ve" />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_PE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>La universidad gestiona datos que nadie ve — Auditoría de sistemas académicos</title>
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <Topbar />
    <main id="contenido">
      <Hero />
      <div class="cuerpo contenedor">
        <CapituloObjeto />
        <CapituloEvidencia />
        <CapituloMetodo />
        <CapituloLimites />
        <CapituloTesis />
        <Fuentes />
      </div>
    </main>
    <Pie />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>

<style>
  /* Las secciones ocupan el ancho completo salvo el cuerpo, que vive dentro
     del contenedor. El hero y el pie se salen del contenedor a propósito. */
  .cuerpo :global(section) {
    scroll-margin-top: 5rem;
  }
</style>
